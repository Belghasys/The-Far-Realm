# ============================================================
#  The Far Realm — .gitignore  (PUBLIC repo — be strict)
# ============================================================

# --- Secrets / env (NEVER COMMIT) ---
.env
.env.*
*.local
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets.*
**/serviceAccount*.json
.git-credentials

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Node / build output ---
node_modules
**/node_modules
dist
dist-ssr
coverage
.firebase

# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/

# --- Installer build artifacts (regenerated by BUILD.ps1) ---
installer/dist-installer/
installer/tools/
installer/launcher/client/
installer/launcher/release/
installer/launcher/node_modules/
# Large local model weights must never enter git
**/Local Models/
*.safetensors
*.ckpt
*.bin
*.gguf

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
