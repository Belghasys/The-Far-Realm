# ============================================================
#  The Far Realm — .gitignore  (PUBLIC repo — be strict)
# ============================================================

# --- Secrets / env (NEVER COMMIT) ---
.env
.env.*
*.local
.env.local
.env.*.local
*.pem
*.key
*.p12
*.pfx
secrets.*
**/serviceAccount*.json
.git-credentials

# --- Logs ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Node / build output ---
node_modules
**/node_modules
dist
dist-ssr
coverage
.firebase

# --- Banque audio migree (64 Mo) ---
# Retirez ces deux lignes si vous voulez que le depot soit auto-suffisant
# pour un deploiement cloud depuis un clone neuf.
public/media/sfx/
public/media/music/

# --- Python ---
__pycache__/
**/__pycache__/
*.py[cod]
.venv/
venv/

# --- Installer build artifacts (regenerated by BUILD.ps1) ---
installer/dist-installer/
installer/tools/
installer/launcher/client/
installer/launcher/release/
installer/launcher/node_modules/
# Large local model weights must never enter git
**/Local Models/
*.safetensors
*.ckpt
*.bin
*.gguf

# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Sources d'illustration (JPEG bruts, ~80 Mo) ---
# Les versions optimisees et servies vivent dans public/art/, qui EST versionne.
# Les originaux restent sur le disque (OneDrive) : inutiles au build, trop lourds
# pour un depot public.
"Website Material"/
Website Material/
*.mp3
!public/media/**/*.mp3

# Maquette UI (Claude Design) : la page assemblee pese 2,4 Mo et se regenere
# depuis les .dc.html ; seules les sources sont versionnees.
.maquette/ui-en-jeu-*.html
