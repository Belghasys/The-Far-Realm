{
  "name": "dnd-far-realm-launcher",
  "version": "1.0.0",
  "description": "Desktop launcher for DnD: The Far Realm - drives the local media engine and serves the game UI.",
  "main": "main.js",
  "author": "Salim AI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . \"DnD - The Far Realm\" --platform=win32 --arch=x64 --out=release --overwrite --prune=true --icon=../assets/icon.ico"
  },
  "devDependencies": {
    "@electron/packager": "^20.2.0",
    "electron": "^33.0.0"
  }
}
