rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read and write their own data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Games collection: anyone authenticated can read, but only the host can write
    match /games/{gameId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }

    // Compteurs de quota média + kill-switch : écrits UNIQUEMENT par les
    // Cloud Functions via l'Admin SDK (qui bypasse ces règles). Aucun client
    // ne doit pouvoir lire ni remettre à zéro son compteur. Le default-deny
    // final couvre déjà ce cas — ces blocs le rendent EXPLICITE pour que de
    // futures éditions des règles ne les ouvrent pas par accident.
    // Plan d'abonnement : le joueur lit le sien ; seul le webhook Paddle
    // (Admin SDK) écrit. Les traces de suppression ne sont lisibles par personne.
    match /plans/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    match /deletions/{doc} {
      allow read, write: if false;
    }
    match /usage/{doc} {
      allow read, write: if false;
    }
    match /config/{doc} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
